    text body
    daterange published "optional"
    int sort_order
    uuid written_by_account_id FK "→ iam.user_account; optional"
  }
  t_kb_feedback["tms.kb_feedback"] {
    bigint id PK
    uuid kb_article_id FK
    bool was_helpful
    date given_on
  }
  t_kb_article ||--o{ t_kb_feedback : "kb_article_id"
  classDef hub fill:#fff6d6,stroke:#a16207,stroke-width:2px
